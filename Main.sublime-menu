[
	{
		"caption": "Preferences",
		"mnemonic": "n",
		"id": "preferences",
		"children":
		[
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children":
				[
					{
						"caption": "Google Spell Check",
						"children":
						[
							{
								"caption": "Example Key Bindings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/Google Spell Check/Example.sublime-keymap",
									"user_file": "${packages}/User/Default (${platform}).sublime-keymap"
								}
							},
							{ "caption": "-" }
						]
					}
				]
			}
		]
	}
]
